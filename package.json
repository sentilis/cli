{
  "name": "@sentilis/cli",
  "version": "4.1.0",
  "description": "Sentilis CLI — publish Markdown bio, press, market, prime and gallery content to Sentilis. Built on @sentilis/sdk.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "sentilis": "dist/index.js"
  },
  "main": "dist/compat/index.js",
  "types": "dist/compat/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/compat/index.d.ts",
      "import": "./dist/compat/index.js",
      "default": "./dist/compat/index.js"
    },
    "./node": {
      "types": "./dist/compat/node.d.ts",
      "import": "./dist/compat/node.js",
      "default": "./dist/compat/node.js"
    },
    "./bio": {
      "types": "./dist/compat/bio.d.ts",
      "import": "./dist/compat/bio.js",
      "default": "./dist/compat/bio.js"
    },
    "./bio/markdown": {
      "types": "./dist/compat/bio.markdown.d.ts",
      "import": "./dist/compat/bio.markdown.js",
      "default": "./dist/compat/bio.markdown.js"
    },
    "./press": {
      "types": "./dist/compat/press.d.ts",
      "import": "./dist/compat/press.js",
      "default": "./dist/compat/press.js"
    },
    "./press/markdown": {
      "types": "./dist/compat/press.markdown.d.ts",
      "import": "./dist/compat/press.markdown.js",
      "default": "./dist/compat/press.markdown.js"
    },
    "./market": {
      "types": "./dist/compat/market.d.ts",
      "import": "./dist/compat/market.js",
      "default": "./dist/compat/market.js"
    },
    "./market/markdown": {
      "types": "./dist/compat/market.markdown.d.ts",
      "import": "./dist/compat/market.markdown.js",
      "default": "./dist/compat/market.markdown.js"
    },
    "./prime": {
      "types": "./dist/compat/prime.d.ts",
      "import": "./dist/compat/prime.js",
      "default": "./dist/compat/prime.js"
    },
    "./prime/markdown": {
      "types": "./dist/compat/prime.markdown.d.ts",
      "import": "./dist/compat/prime.markdown.js",
      "default": "./dist/compat/prime.markdown.js"
    },
    "./gallery": {
      "types": "./dist/compat/gallery.d.ts",
      "import": "./dist/compat/gallery.js",
      "default": "./dist/compat/gallery.js"
    },
    "./gallery/markdown": {
      "types": "./dist/compat/gallery.markdown.d.ts",
      "import": "./dist/compat/gallery.markdown.js",
      "default": "./dist/compat/gallery.markdown.js"
    },
    "./workspace": {
      "types": "./dist/compat/workspace.d.ts",
      "import": "./dist/compat/workspace.js",
      "default": "./dist/compat/workspace.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/index.js"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "verify": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {
    "@sentilis/sdk": "^1.0.0",
    "citty": "^0.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "sentilis",
    "cli",
    "markdown",
    "bio",
    "press",
    "market",
    "prime",
    "gallery",
    "publishing"
  ],
  "homepage": "https://about.sentilis.me",
  "bugs": {
    "url": "https://github.com/sentilis/cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sentilis/cli.git"
  }
}

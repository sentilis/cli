{
  "name": "@sentilis/cli",
  "version": "0.5.0",
  "description": "Sentilis CLI",
  "bin": {
    "sentilis": "dist/index.js"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @sentilis/core && tsc",
    "build:cli": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@sentilis/core": "*",
    "citty": "^0.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3"
  }
}
